# ~/.editorconfig: cross-editor formatting defaults.
# See https://editorconfig.org for supported editors.
root = true

[*]
charset             = utf-8
end_of_line         = lf
indent_style        = space
indent_size         = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# ~/.bashrc: sourced for interactive bash sessions.

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# Source all *.sh files from a directory (silently skips missing dirs)
_source_dir() {
    local dir="$1"
    [ -d "$dir" ] || return
    for f in $(find -L "$dir" -maxdepth 1 -type f -name '*.sh' | sort); do
        # shellcheck source=/dev/null
        source "$f"
    done
}

# 3-tier load: base → platform → host
_source_dir "${HOME}/.shellrc.d"
_source_dir "${HOME}/.shellrc.d/platform/$(uname -s | tr '[:upper:]' '[:lower:]')"
_source_dir "${HOME}/.shellrc.d/host/$(hostname -s)"
unset _source_dir

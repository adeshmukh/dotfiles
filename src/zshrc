# ~/.zshrc: sourced for interactive zsh sessions.

# Source all *.sh files from a directory (silently skips missing dirs)
_source_dir() {
    local dir="$1"
    [ -d "$dir" ] || return
    for f in $(find -L "$dir" -maxdepth 1 -type f -name '*.sh' | sort); do
        # shellcheck source=/dev/null
        source "$f"
    done
}

# 3-tier load: base → platform → host
_source_dir "${HOME}/.shellrc.d"
_source_dir "${HOME}/.shellrc.d/platform/$(uname -s | tr '[:upper:]' '[:lower:]')"
_source_dir "${HOME}/.shellrc.d/host/$(hostname -s)"
unset -f _source_dir

# --- Zsh-specific options ---
setopt AUTO_CD              # cd by typing directory name alone
setopt HIST_IGNORE_DUPS     # don't record duplicate commands
setopt HIST_IGNORE_SPACE    # don't record commands starting with a space
setopt SHARE_HISTORY        # share history across sessions
setopt CORRECT              # suggest corrections for mistyped commands
setopt PROMPT_SUBST         # enable parameter expansion in PS1

HISTSIZE=100000
SAVEHIST=100000
HISTFILE="${HOME}/.zsh_history"

# Case-insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
autoload -Uz compinit && compinit

# --- Prompt (native vcs_info — no external dependencies) ---
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %b '

_prompt_precmd() {
    vcs_info
    print -Pn "\e]0;%n@%m: %~\a"   # terminal title
}
precmd_functions+=(_prompt_precmd)

PS1='%F{yellow}${vcs_info_msg_0_}%f%F{red} %T %f%F{blue} %m %f%F{white} %~ %f%% '

# --- Plugins ---
# Sources plugins installed by package manager or `make plugins`.
# Missing paths are silently skipped — no errors if a plugin isn't installed.
_source_plugin() {
    local name="$1"; shift
    local p
    for p in "$@"; do
        if [ -f "$p" ]; then
            source "$p"
            return
        fi
    done
}

# zsh-autosuggestions: fish-style inline suggestions
_source_plugin zsh-autosuggestions \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    "${HOME}/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"

# zsh-syntax-highlighting: colour commands as you type (load last)
_source_plugin zsh-syntax-highlighting \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    "${HOME}/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

unset -f _source_plugin


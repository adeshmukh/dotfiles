# Aptfile — Debian/Ubuntu packages
# Apply with: apt-bundle packages/Aptfile
# See: https://apt-bundle.org/aptfile-format.html

# --- Keys and repos (processed before packages) ---

# GitHub CLI
key https://cli.github.com/packages/githubcli-archive-keyring.gpg
deb "[arch=amd64] https://cli.github.com/packages stable main"

# Charm (glow, etc.)
key https://repo.charm.sh/apt/gpg.key
deb "https://repo.charm.sh/apt/ * *"

# Golang (latest stable)
ppa ppa:longsleep/golang-backports

# --- Packages ---

# Core
apt build-essential
apt curl
apt git
apt make
apt tmux
apt tree
apt unzip
apt vim
apt wget
apt zsh

# Shell / terminal
# bat: cat with syntax highlighting (binary: batcat on Debian/Ubuntu)
apt bat
apt btop
apt direnv
apt glow
apt keychain
# ripgrep: fast grep alternative (binary: rg)
apt ripgrep
apt zsh-autosuggestions
apt zsh-syntax-highlighting

# Dev
apt gh
apt golang-go
apt jq
apt nodejs
apt npm
apt python3
apt python3-pip
apt software-properties-common
